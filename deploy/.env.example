# Copy to deploy/.env (gitignored) and fill in.
PROJECT=your-gcp-project-id
REGION=asia-south1
# Service account the backend runs as. Needs: Agent Platform User, Cloud Datastore User, Logs Writer.
API_SA=cafe-api@your-gcp-project-id.iam.gserviceaccount.com
# Comma-separated emails that become managers on first sign-in (optional).
BOOTSTRAP_MANAGERS=
